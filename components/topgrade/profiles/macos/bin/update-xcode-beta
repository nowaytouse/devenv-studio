#!/usr/bin/env python3.15
import argparse
import subprocess
import sys
import tempfile
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description="Check or install Xcode Beta using DevEnv Studio's Topgrade engine.")
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--apply", action="store_true")
    args = parser.parse_args()

    operation = "xcode_beta_check" if args.check else "xcode_beta_install"
    with tempfile.TemporaryDirectory(prefix="studio-xcode-beta-") as directory:
        config = Path(directory) / "topgrade.toml"
        config.write_text(f'[commands]\n"Xcode Beta Update" = "@studio:{operation}"\n', encoding="utf-8")
        return subprocess.run([
            Path.home() / ".local/bin/topgrade", "--config", config,
            "--only", "custom_commands", "--no-tmux", "--no-ask-retry", "--auto-retry", "0",
        ]).returncode


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except OSError as exc:
        print(f"Xcode: ERROR — {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
