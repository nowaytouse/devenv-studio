  "actions": [
    {
      "id": "privacy-advertising-id",
      "title": "关闭应用广告 ID",
      "description": "阻止应用使用当前账户的广告 ID 进行个性化广告。不会阻止所有广告。",
      "category": "privacy",
      "sources": [
        "winutil",
        "sophia"
      ],
      "evidence": [
        "https://github.com/ChrisTitusTech/winutil/blob/7514faf0d0f4bff9b6c5d9213426ab52520cfac4/config/tweaks.json",
        "https://github.com/farag2/Sophia-Script-for-Windows/blob/eeef532fc5f37129fe77ee58342f112f3bb71d39/src/Sophia_Script_for_Windows_10_LTSC_2021/Module/Sophia.psm1",
        "https://github.com/farag2/Sophia-Script-for-Windows/blob/eeef532fc5f37129fe77ee58342f112f3bb71d39/src/Sophia_Script_for_Windows_11_LTSC_2024/Module/Sophia.psm1"
      ],
      "targets": [
        "win10_ltsc2021",
        "win11_ltsc2024"
      ],
      "restart": "建议注销后重新登录",
      "risk": "用户偏好；可恢复原值",
      "changes": [
        {
          "hive": "current_user",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo",
          "name": "Enabled",
          "value": 0
        }
      ]
    },
    {
